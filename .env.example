# Copy this file to .env and fill in real values. Never commit .env itself.

FLASK_APP=run.py
FLASK_ENV=development

# PostgreSQL connection — adjust user/password/db name to match your local setup
DATABASE_URL=postgresql+psycopg2://grievdesk_user:changeme@localhost:5432/grievdesk

# Generate a real random string for production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=replace-this-with-a-long-random-string

# Gemini powers every AI feature: classification, drafting, rules Q&A and voice input
GEMINI_API_KEY=
# Optional — override if Google deprecates the default model
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated backups, tried in order if the main model is overloaded (503), retired (404) or out of quota (429)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Optional: where voice notes attached to complaints are stored (default: instance/audio)
# AUDIO_DIR=

# Amenity booking rules (all optional)
# SOCIETY_TIMEZONE=Asia/Kolkata
# MAX_BOOKING_HOURS=4
# MAX_BOOKING_DAYS_AHEAD=30

# Housekeeping (all optional)
# ESCALATION_DAYS=5            # a complaint nobody has touched for this many days is escalated
# DUPLICATE_WINDOW_HOURS=48    # same category + same block within this window = duplicate report
# CHAT_RETENTION_DAYS=7        # chat transcripts older than this are deleted (complaints are never touched)
# ENABLE_SCHEDULER=true        # run the jobs inside `python run.py` (or use cron + `flask jobs ...`)

# Translate-on-read tuning (optional)
# TRANSLATE_BATCH_ITEMS=25
# TRANSLATE_BATCH_CHARS=8000
